  <div id="barra-download" style="position: fixed; top: 0; left: 0;display: flex; justify-content: flex-end;  width: 100%; background: #f4f4f4; padding: 12px; border-bottom: 1px solid #ccc; font-family: Arial, sans-serif;  z-index: 999999;">
        <button onclick="baixarArquivo()" style="margin-right: 30px;background: #28a745; color: white; border: none; padding: 8px 18px; font-size: 14px; font-weight: bold; cursor: pointer; border-radius: 4px; display: inline-flex; align-items: center; gap: 8px;">
            <span style="display: inline-block; width: 14px; height: 14px; border: 2px solid white; border-radius: 2px; position: relative; box-sizing: border-box; background: #28a745;">
                <span style="position: absolute; top: 0; right: 2px; width: 3px; height: 3px; background: white; border-bottom-left-radius: 1px;"></span>
                <span style="position: absolute; bottom: 0; left: 2px; width: 6px; height: 4px; background: white;"></span>
            </span>
            Baixar como arquivo Excel (.xls)
        </button>
    </div>
            
    <script>
    function baixarArquivo() {
        var barra = document.getElementById("barra-download");
        barra.remove();
            
        var htmlCompleto = document.documentElement.outerHTML;
            
        // Garante que se houver menção ao charset antigo no HTML, ele seja interpretado como UTF-8 no Excel
        htmlCompleto = htmlCompleto.replace(/charset=iso-8859-1/g, "charset=utf-8");
            
        // CORREÇÃO AQUI: Adicionamos o BOM do UTF-8 (\uFEFF) antes do conteúdo HTML
        var blob = new Blob(["\uFEFF", htmlCompleto], { type: "application/vnd.ms-excel;charset=utf-8" });
            
        var link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = "2026_10_tabela_de_correcao_monetaria_6abea2073577b";
            
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
            
        document.body.insertBefore(barra, document.body.firstChild);
    }
    </script>
            
    <style>
        /* Desloca o conteúdo da planilha para baixo para não sumir sob a barra fixa */
        body { margin-top: 60px !important; }
            
        @media print {
            #barra-download { display: none !important; }
            body { margin-top: 0 !important; }
        }
    </style>
    
</body></html>