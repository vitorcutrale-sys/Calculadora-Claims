        /* --- Interface da Barra de Download --- */
        #barra-download {
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            justify-content: flex-end;
            width: 100%;
            background: #f4f4f4;
            padding: 12px;
            border-bottom: 1px solid #ccc;
            font-family: Arial, sans-serif;
            z-index: 999999;
            box-sizing: border-box;
        }
        #barra-download button {
            margin-right: 30px;
            background: #28a745;
            color: white;
            border: none;
            padding: 8px 18px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        #barra-download .icon-box {
            display: inline-block;
            width: 14px;
            height: 14px;
            border: 2px solid white;
            border-radius: 2px;
            position: relative;
            box-sizing: border-box;
            background: #28a745;
        }
        #barra-download .icon-dot {
            position: absolute;
            top: 0;
            right: 2px;
            width: 3px;
            height: 3px;
            background: white;
            border-bottom-left-radius: 1px;
        }
        #barra-download .icon-arrow {
            position: absolute;
            bottom: 0;
            left: 2px;
            width: 6px;
            height: 4px;
            background: white;
        }

        /* --- Impressão --- */
        @media print {
            #barra-download { display: none !important; }
            body { margin-top: 0 !important; }
        }</style></head>
