    <script>
    function baixarArquivo() {
        var barra = document.getElementById("barra-download");
        barra.remove();
            
        var htmlCompleto = document.documentElement.outerHTML;
            
        // Garante que se houver menção ao charset antigo no HTML, ele seja interpretado como UTF-8 no Excel
        htmlCompleto = htmlCompleto.replace(/charset=iso-8859-1/g, "charset=utf-8");
            
        // CORREÇÃO AQUI: Adicionamos o BOM do UTF-8 (\uFEFF) antes do conteúdo HTML
        var blob = new Blob(["\uFEFF", htmlCompleto], { type: "application/vnd.ms-excel;charset=utf-8" });
            
        var link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = "2026_11_tabela_de_correcao_monetaria_6ae9d398149f7";
            
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
            
        document.body.insertBefore(barra, document.body.firstChild);
    }
    </script>
            
    <style>
        /* Desloca o conteúdo da planilha para baixo para não sumir sob a barra fixa */
        body { margin-top: 60px !important; }
            
        @media print {
            #barra-download { display: none !important; }
            body { margin-top: 0 !important; }
        }
    </style>
    
